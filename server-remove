#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

config_file="$HOME/.config/cpanel-tools/servers"

if [ ! -f "$config_file" ]; then
  echo -e "${RED}Error: Config file not found${NC}"
  exit 1
fi

if [ $# -ne 1 ]; then
  echo -e "${RED}Usage: $0 server_name${NC}"
  exit 1
fi

server_name="$1"

if ! grep -q "^$server_name:" "$config_file"; then
  echo -e "${RED}Error: Server '$server_name' not found${NC}"
  exit 1
fi

# Show server details before removal (mask token)
echo -e "${YELLOW}About to remove this server:${NC}"
grep "^$server_name:" "$config_file" | while IFS=: read -r name ip type token; do
  masked_token="${token:0:4}...${token: -4}"
  echo "Name: $name"
  echo "IP: $ip"
  echo "Type: $type"
  echo "Token: $masked_token"
done

read -p "Are you sure you want to remove this server? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
  sed -i.bak "/^$server_name:/d" "$config_file"
  chmod 600 "$config_file"
  echo -e "${GREEN}Successfully removed server '$server_name'${NC}"
else
  echo "Operation cancelled"
fi
