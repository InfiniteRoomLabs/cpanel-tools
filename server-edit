#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

config_file="$HOME/.config/cpanel-tools/servers"

if [ ! -f "$config_file" ]; then
  echo -e "${RED}Error: Config file not found${NC}"
  exit 1
fi

usage() {
  echo "Usage: $0 [options] server_name"
  echo "Options:"
  echo "  --ip NEW_IP        Update IP address"
  echo "  --type TYPE        Update type (whm or cpanel)"
  echo "  --token TOKEN      Update API token"
  echo
  echo "If no options are provided, opens the config file in \$EDITOR"
  exit 1
}

# Check if no arguments provided
if [ $# -eq 0 ]; then
  # Check if EDITOR is set
  if [ -z "$EDITOR" ]; then
    echo -e "${YELLOW}Warning: \$EDITOR not set, defaulting to vi${NC}"
    EDITOR="vi"
  fi

  # Create temporary file with same permissions
  temp_file=$(mktemp)
  chmod 600 "$temp_file"
  cp "$config_file" "$temp_file"

  # Open in editor
  $EDITOR "$temp_file"

  # If file was modified
  if ! cmp -s "$config_file" "$temp_file"; then
    # Validate the modified file
    valid=true
    while IFS=: read -r name ip type token || [[ -n "$name" ]]; do
      # Skip empty lines
      [ -z "$name" ] && continue

      # Trim whitespace
      ip=$(echo "$ip" | tr -d '[:space:]')
      type=$(echo "$type" | tr -d '[:space:]')

      # Validate IP
      if ! echo "$ip" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' >/dev/null; then
        echo -e "${RED}Error: Invalid IP format: $ip${NC}"
        valid=false
      fi

      # Validate type only if it's not empty. If it's empty then we'll just assume that we haven't set up an API token yet
      if [ -n "$type" ]; then
        if [[ "$type" != "whm" && "$type" != "cpanel" ]]; then
          echo -e "${RED}Error: Invalid type '$type' for server '$name': must be 'whm' or 'cpanel'${NC}"
          valid=false
        fi
        # Validate token not empty. Same rules here as above for the type
        # If the token is empty, then we'll just assume that we haven't set up an API token yet
        if [ -z "$token" ]; then
          echo -e "${RED}Error: Empty token for server '$name'${NC}"
          valid=false
        fi
      fi

    done <"$temp_file"

    if [ "$valid" = true ]; then
      mv "$temp_file" "$config_file"
      chmod 600 "$config_file"
      echo -e "${GREEN}Config file updated successfully${NC}"
    else
      echo -e "${RED}Error: Invalid configuration detected. Changes not saved.${NC}"
      echo "Original file preserved at: $config_file"
      echo "Your changes are in: $temp_file"
      exit 1
    fi
  else
    echo "No changes made"
    rm "$temp_file"
  fi
  exit 0
fi

# Original script functionality for specific field updates
server_name=""
new_ip=""
new_type=""
new_token=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
  --ip)
    new_ip="$2"
    shift 2
    ;;
  --type)
    new_type="$2"
    shift 2
    ;;
  --token)
    new_token="$2"
    shift 2
    ;;
  *)
    if [ -z "$server_name" ]; then
      server_name="$1"
    else
      usage
    fi
    shift
    ;;
  esac
done

if [ -z "$server_name" ]; then
  usage
fi

if ! grep -q "^$server_name:" "$config_file"; then
  echo -e "${RED}Error: Server '$server_name' not found${NC}"
  exit 1
fi

# Get current values
IFS=: read -r curr_name curr_ip curr_type curr_token < <(grep "^$server_name:" "$config_file")

# Validate new values if provided
if [ -n "$new_ip" ]; then
  if ! echo "$new_ip" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' >/dev/null; then
    echo -e "${RED}Error: Invalid IP address format${NC}"
    exit 1
  fi
fi

if [ -n "$new_type" ]; then
  if [[ "$new_type" != "whm" && "$new_type" != "cpanel" ]]; then
    echo -e "${RED}Error: Type must be either 'whm' or 'cpanel'${NC}"
    exit 1
  fi
fi

# Show current and new values
echo -e "${YELLOW}Current configuration:${NC}"
echo "Name: $curr_name"
echo "IP: $curr_ip"
echo "Type: $curr_type"
echo "Token: ${curr_token:0:4}...${curr_token: -4}"

echo -e "\n${YELLOW}New configuration:${NC}"
echo "Name: $curr_name"
echo "IP: ${new_ip:-$curr_ip}"
echo "Type: ${new_type:-$curr_type}"
echo "Token: ${new_token:+${new_token:0:4}...${new_token: -4}}"

read -p "Are you sure you want to update this server? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
  # Build new line
  new_line="$curr_name:"
  new_line+="${new_ip:-$curr_ip}:"
  new_line+="${new_type:-$curr_type}:"
  new_line+="${new_token:-$curr_token}"

  sed -i.bak "s|^$server_name:.*|$new_line|" "$config_file"
  chmod 600 "$config_file"
  echo -e "${GREEN}Successfully updated server '$server_name'${NC}"
else
  echo "Operation cancelled"
fi
