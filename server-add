#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

config_file="$HOME/.config/cpanel-tools/servers"
config_dir="$(dirname "$config_file")"

# Ensure config directory exists
if [ ! -d "$config_dir" ]; then
  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
fi

# Create config file if it doesn't exist
if [ ! -f "$config_file" ]; then
  touch "$config_file"
  chmod 600 "$config_file"
fi

# Check arguments
if [ $# -ne 4 ]; then
  echo -e "${RED}Usage: $0 server_name ip_address type token${NC}"
  echo "type must be either 'whm' or 'cpanel'"
  exit 1
fi

server_name="$1"
ip_address="$2"
type="$3"
token="$4"

# Validate IP address format
if ! echo "$ip_address" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' >/dev/null; then
  echo -e "${RED}Error: Invalid IP address format${NC}"
  exit 1
fi

# Validate type
if [[ "$type" != "whm" && "$type" != "cpanel" ]]; then
  echo -e "${RED}Error: Type must be either 'whm' or 'cpanel'${NC}"
  exit 1
fi

# Check if server name already exists
if grep -q "^$server_name:" "$config_file"; then
  echo -e "${RED}Error: Server name '$server_name' already exists${NC}"
  exit 1
fi

# Check if IP already exists
if grep -q ":$ip_address:" "$config_file"; then
  echo -e "${RED}Warning: IP '$ip_address' already exists in the config${NC}"
  read -p "Do you want to continue? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# Add entry
echo "$server_name:$ip_address:$type:$token" >>"$config_file"
chmod 600 "$config_file"
echo -e "${GREEN}Successfully added server '$server_name' with IP '$ip_address'${NC}"
