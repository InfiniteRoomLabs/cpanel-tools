#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Default values
DOMAIN=""
EXCLUDE_FILES="cpanel"
EXCLUDE_DIR="$HOME/.config/cpanel-tools/excludes"
RSYNC_OPTIONS="-rPzhv --itemize-changes"

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] domain.com

Options:
  -e, --excludes FILES  Comma-separated list of exclude files to use
                        [default: cpanel]
  -o, --output DIR      Output directory [default: ./domain.com]
  --dry-run             Show what would be done
  --debug               Enable debug mode
  --help                Show this help message

The exclude files should exist in $EXCLUDE_DIR/

Available exclude files:
$(find "$EXCLUDE_DIR" -type f 2>/dev/null | awk -F '/' '{print $NF}' | sed 's/^/    /')
EOF
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
  case $1 in
  -e | --excludes)
    EXCLUDE_FILES="$2"
    shift 2
    ;;
  -o | --output)
    OUTPUT_DIR="$2"
    shift 2
    ;;
  --dry-run)
    RSYNC_OPTIONS+=" --dry-run"
    shift
    ;;
  --debug)
    set -x
    shift
    ;;
  --help)
    usage
    exit 0
    ;;
  *)
    if [ -z "$DOMAIN" ]; then
      DOMAIN="$1"
    else
      echo -e "${RED}Error: Unexpected argument '$1'${NC}"
      usage
      exit 1
    fi
    shift
    ;;
  esac
done

# Validate domain
if [ -z "$DOMAIN" ]; then
  echo -e "${RED}Error: Domain is required${NC}"
  usage
  exit 1
fi

# Set default output directory if not specified
if [ -z "$OUTPUT_DIR" ]; then
  OUTPUT_DIR="./$DOMAIN"
fi

# Check if excludes directory exists
if [ ! -d "$EXCLUDE_DIR" ]; then
  echo -e "${RED}Error: Excludes directory not found at $EXCLUDE_DIR${NC}"
  exit 1
fi

# Validate exclude files
RSYNC_EXCLUDE_OPTS=""
IFS=',' read -ra EXCLUDE_ARRAY <<<"$EXCLUDE_FILES"
for exclude in "${EXCLUDE_ARRAY[@]}"; do
  exclude_file="$EXCLUDE_DIR/$exclude"
  if [ ! -f "$exclude_file" ]; then
    echo -e "${RED}Error: Exclude file not found: $exclude_file${NC}"
    exit 1
  fi
  RSYNC_EXCLUDE_OPTS+=" --exclude-from=$exclude_file"
done

# Look up the server for the domain
echo -e "${BLUE}Looking up server for $DOMAIN...${NC}"
server_lookup=$(server-lookup "$DOMAIN" -f json)

# Check if lookup was successful
if ! echo "$server_lookup" | jq -e '.success' >/dev/null; then
  error_msg=$(echo "$server_lookup" | jq -r '.error')
  echo -e "${RED}Error: $error_msg${NC}"
  exit 1
fi

# Extract server name from lookup result
server_name=$(echo "$server_lookup" | jq -r '.server.name')
server_type=$(echo "$server_lookup" | jq -r '.server.type')

# Verify it's a WHM server
if [ "$server_type" != "whm" ]; then
  echo -e "${RED}Error: Server '$server_name' is not a WHM server${NC}"
  exit 1
fi

# Query for account details
echo -e "${BLUE}Getting account details...${NC}"
account_info=$(server-account-query -s "$server_name" -t domain -v "$DOMAIN" -w "user,domain,ip" -f csv | tail -n1)

if [ -z "$account_info" ]; then
  echo -e "${RED}Error: Domain not found on server $server_name${NC}"
  exit 1
fi

# Parse account info
IFS=',' read -r username domain server_ip <<<"$account_info"

echo -e "${GREEN}Found account:${NC}"
echo "Username: $username"
echo "Domain: $domain"
echo "Server IP: $server_ip"

# Create output directory if it doesn't exist
mkdir -p "$OUTPUT_DIR"

# Build rsync command
rsync_cmd="rsync $RSYNC_OPTIONS$RSYNC_EXCLUDE_OPTS"
rsync_source="root@$server_ip:/home/$username/"
rsync_dest="$OUTPUT_DIR/"
full_rsync_cmd="$rsync_cmd $rsync_source $rsync_dest"

echo -e "\n${BLUE}Starting download with command:${NC}"
echo "$full_rsync_cmd"

# Execute rsync
$full_rsync_cmd

# Check rsync exit status
if [ $? -eq 0 ]; then
  echo -e "\n${GREEN}Download completed successfully to $OUTPUT_DIR${NC}"
else
  echo -e "\n${RED}Error: Download failed${NC}"
  exit 1
fi
